{
  "info": {
    "name": "GarageDesk — Vehicle Service Job Card & Bay Scheduling API",
    "_postman_id": "7f8b8c20-1a2b-4c3d-8e4f-5a6b7c8d9e0f",
    "description": "Postman Collection for Sri Eshwar College of Engineering Project Leap Question 67 (Student Reg No: 060).\nCovers all 5 core features, normal paths, and edge cases (Bay Conflict 409, Quality Check Gate 400).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Vehicles",
      "item": [
        {
          "name": "Register New Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"TN-38-ZZ-9999\",\n  \"brand\": \"Mahindra\",\n  \"model\": \"XUV700 AX7\",\n  \"manufacturingYear\": 2023,\n  \"ownerName\": \"Kavitha Sundaram\",\n  \"ownerPhone\": \"9842100099\",\n  \"ownerEmail\": \"kavitha@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
