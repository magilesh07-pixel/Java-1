    {
      "name": "4. Job Cards & Scheduling (Core Requirements)",
      "item": [
        {
          "name": "Feature 1: Create Job Card (WAITING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 2,\n  \"requestedServices\": \"Periodic 20,000 km Service, Engine Oil Flush, AC Filter Replacement\",\n  \"customerComplaints\": \"AC cooling is slow during peak afternoons\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards"]
            }
          }
        },
        {
          "name": "Feature 2: Assign Bay & Mechanic (Normal Path)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bayId\": 2,\n  \"mechanicId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/2/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "2", "assign"]
            },
            "description": "Assigns Job #2 into Bay 2 (which is free) and technician Suresh Babu."
          }
        },
        {
          "name": "Rule 1 Edge Case: Bay Conflict (Should Fail with 409 Conflict)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bayId\": 1,\n  \"mechanicId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/2/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "2", "assign"]
            },
            "description": "Tests Business Rule 1: Attempting to assign Job #2 into Bay 1 (which is already occupied by Job #1) MUST return 409 Conflict!"
          }
        },
        {
          "name": "Add Spare Part to Job Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Mobil 1 ESP 5W-30 Fully Synthetic Engine Oil (4L)\",\n  \"itemType\": \"PART\",\n  \"quantity\": 1,\n  \"unitPrice\": 3200.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1", "items"]
            }
          }
        },
        {
          "name": "Add Labour Charge to Job Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Brake Fluid Flush & Bleeding Labour\",\n  \"itemType\": \"LABOUR_SERVICE\",\n  \"quantity\": 1,\n  \"unitPrice\": 750.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1", "items"]
            }
          }
        },
        {
          "name": "Rule 2 Edge Case: Skip QC (Should Fail with 400 Bad Request)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1", "status"]
            },
            "description": "Tests Business Rule 2: Attempting to move Job #1 directly from IN_PROGRESS to COMPLETED without passing QUALITY_CHECK MUST return 400 Bad Request!"
          }
        },
        {
          "name": "Feature 3: Transition to QUALITY_CHECK (Normal Path)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"QUALITY_CHECK\",\n  \"qualityCheckNotes\": \"Passed 24-point road test, brake pads at 8mm, fluid levels verified.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1", "status"]
            }
          }
        },
        {
          "name": "Feature 3: Transition to COMPLETED (After QC - Frees Bay!)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1", "status"]
            },
            "description": "Moves to COMPLETED now that QUALITY_CHECK has passed. Automatically sets Bay 1 to AVAILABLE!"
          }
        },
        {
          "name": "Get Job Card By ID (Full Details)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/job-cards/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards", "1"]
            }
          }
        },
        {
          "name": "Get All Job Cards (Filter by Status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/job-cards?status=IN_PROGRESS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-cards"],
              "query": [
                {
                  "key": "status",
                  "value": "IN_PROGRESS"
                }
              ]
            }
          }
        }
      ]
    },
